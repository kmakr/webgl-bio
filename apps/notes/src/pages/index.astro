---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
}).format(date);
---

<BaseLayout>
  <SiteHeader />
  <main class="page-shell home-shell">
    <header class="home-intro">
      <h1 id="page-title">Notes</h1>
      <p>Working notes on interfaces, systems, tools, and experiments.</p>
    </header>

    <section aria-labelledby="recent-title">
      <h2 class="section-title" id="recent-title">Recent posts</h2>
      <ol class="post-list">
        {notes.map((note) => (
          <li>
            <a href={`/notes/${note.id}`}>
              <span>{note.data.title}</span>
              <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
            </a>
            <p>{note.data.summary}</p>
          </li>
        ))}
      </ol>
    </section>
  </main>
  <footer class="site-footer">
    <span>© {new Date().getFullYear()} Theo Azriel</span>
    <a href="mailto:theo.azriel@icloud.com">Email</a>
  </footer>
</BaseLayout>
