---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout>
  <main class="home">
    <header class="home-intro">
      <h1>
        <img class="mark" src="/favicon.svg" alt="" width="56" height="56" />
        Theo Azriel
      </h1>
      <p class="muted">Photographs, notes, and things built for the web.</p>
    </header>

    <section aria-label="Projects">
      <h2>Projects</h2>
      <a class="item" href="https://gallery.theoazriel.com">
        <span>gallery.theoazriel.com</span>
        <span class="muted">Photographs draped over a simulated cloth. Drag it.</span>
      </a>
      <a class="item" href="https://onisolo.theoazriel.com">
        <span>onisolo.theoazriel.com</span>
        <span class="muted">A monochrome sword game played on a living sheet of ink and paper.</span>
      </a>
    </section>

    <section aria-label="Notes">
      <h2>Notes</h2>
      {notes.map((note) => (
        <a class="item" href={`/notes/${note.id}`}>
          <span>{note.data.title}</span>
          <span class="muted">{note.data.summary}</span>
        </a>
      ))}
    </section>

    <section aria-label="Elsewhere">
      <h2>Elsewhere</h2>
      <p>
        <a href="https://github.com/kmakr">GitHub</a><br />
        <a href="mailto:theo.azriel@icloud.com">Email</a>
      </p>
    </section>
  </main>
</BaseLayout>
