---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
}).format(date).replace(/ (\d{4})$/, ', $1');
---

<BaseLayout>
  <SiteHeader />
  <main>
    <h2 id="page-title">Blog</h2>
    <p>Working notes on interfaces, systems, tools, and experiments.</p>
    <ul class="blog-posts" aria-label="Blog posts">
      {notes.map((note) => (
        <li>
          <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
          <a href={`/notes/${note.id}`}>{note.data.title}</a>
        </li>
      ))}
    </ul>
  </main>
  <footer class="site-footer">
    <p>© {new Date().getFullYear()} Theo Azriel · <a href="mailto:theo.azriel@icloud.com">Email</a></p>
  </footer>
</BaseLayout>
