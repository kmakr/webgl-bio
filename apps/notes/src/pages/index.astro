---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout>
  <main class="home">
    <header class="home-intro">
      <h1>Theo Azriel</h1>
      <p class="muted">Photographs, notes, and things built for the web.</p>
    </header>

    <section aria-label="Gallery">
      <h2>Gallery</h2>
      <p>
        <a href="https://gallery.theoazriel.com">gallery.theoazriel.com</a><br />
        <span class="muted">Photographs draped over a simulated cloth. Drag it.</span>
      </p>
    </section>

    <section aria-label="Notes">
      <h2>Notes</h2>
      {notes.map((note) => (
        <p>
          <a href={`/notes/${note.id}`}>{note.data.title}</a><br />
          <span class="muted">{note.data.summary}</span>
        </p>
      ))}
    </section>

    <section aria-label="Elsewhere">
      <h2>Elsewhere</h2>
      <p>
        <a href="https://github.com/kmakr">GitHub</a><br />
        <a href="mailto:theo.azriel@icloud.com">Email</a>
      </p>
    </section>
  </main>
</BaseLayout>
