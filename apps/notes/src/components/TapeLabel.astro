---
const { count } = Astro.props;
---

<div class="tape-zone" aria-hidden="true">
  <div class="tape-label" data-tape>
    <span>Notes / Theo Azriel</span>
    <span>{String(count).padStart(3, '0')} entries</span>
    <span class="tape-code">260419920104</span>
  </div>
</div>

<script>
  const tape = document.querySelector<HTMLElement>('[data-tape]');

  if (tape && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let startX = 0;
    let startY = 0;
    let offsetX = 0;
    let offsetY = 0;

    const move = (event: PointerEvent) => {
      offsetX += event.clientX - startX;
      offsetY += event.clientY - startY;
      startX = event.clientX;
      startY = event.clientY;
      tape.style.setProperty('--tape-x', `${offsetX}px`);
      tape.style.setProperty('--tape-y', `${offsetY}px`);
    };

    tape.addEventListener('pointerdown', (event) => {
      startX = event.clientX;
      startY = event.clientY;
      tape.setPointerCapture(event.pointerId);
      tape.classList.add('is-dragging');
    });
    tape.addEventListener('pointermove', (event) => {
      if (tape.hasPointerCapture(event.pointerId)) move(event);
    });
    tape.addEventListener('pointerup', (event) => {
      tape.releasePointerCapture(event.pointerId);
      tape.classList.remove('is-dragging');
    });
  }
</script>
