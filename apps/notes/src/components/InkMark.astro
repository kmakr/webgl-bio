<ink-mark class="mark" aria-hidden="true" data-ink-state="static">
  <img src="/favicon.svg" alt="" width="96" height="96" />
  <canvas width="192" height="192"></canvas>
</ink-mark>

<style>
  ink-mark.mark {
    position: relative;
    flex: none;
    width: 96px;
    height: 96px;
    margin-left: -12px;
  }

  img,
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  ink-mark[data-rendered] img {
    opacity: 0;
  }

  ink-mark[data-rendered] canvas {
    opacity: 1;
  }
</style>

<script>
  import '../scripts/ink-mark';
</script>
